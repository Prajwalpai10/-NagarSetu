# NagarSetu Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env to version control.

# ─── Backend Server ───────────────────────────────────────────────────────────

# Port for the Express API server
PORT=4000

# REQUIRED: Long cryptographically random string for signing sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_STRING

# Node environment: development | production
NODE_ENV=development

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Production: replace with explicit HTTPS origins, e.g. https://app.example.gov

# Local user-store file (contains password hashes; keep it private)
USER_STORE_FILE=.data/users.json

# Uploaded complaint-photo directory (keep it private)
UPLOAD_DIR=.data/uploads

# Local development complaint store and uploaded-photo metadata
COMPLAINT_STORE_FILE=.data/complaints.json
ATTACHMENT_METADATA_FILE=.data/attachments.json

# Set when the frontend and API are served from different origins.
# VITE_API_BASE_URL=https://api.example.gov/api

# ─── Seed / Demo Accounts ────────────────────────────────────────────────────
# These are only used on first startup to create demo accounts.
# Change all passwords before deploying to any shared environment.
SEED_ADMIN_EMAIL=admin@nagarsetu.gov.in
SEED_ADMIN_PASSWORD=NagarAdmin@2026!

SEED_OFFICER_EMAIL=officer@bbmp.gov.in
SEED_OFFICER_PASSWORD=OfficerField@2026!

SEED_CITIZEN_EMAIL=priya@example.com
SEED_CITIZEN_PASSWORD=Citizen@2026!

# ─── AI Service ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=MY_GEMINI_API_KEY

# ─── Application URL ─────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ─── Production shared persistence ────────────────────────────────────────────
# Required for production. Use a managed MongoDB service with TLS and backups.
# MONGODB_URI=mongodb://localhost:27017/nagarsetu
# MONGODB_DB_NAME=nagarsetu
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Required in production for durable complaint-photo storage.
# S3_BUCKET=nagarsetu-complaint-photos
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# HTTPS reverse proxy / cookie configuration.
# TRUST_PROXY_HOPS=1
# SESSION_COOKIE_SAME_SITE=strict
# SESSION_COOKIE_DOMAIN=.example.gov

# Set at frontend build time only when frontend and API have different origins.
# Keep both origins on the same site for secure session cookies.
# VITE_API_BASE_URL=https://api.example.gov/api
